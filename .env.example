# Sao chép file này thành .env ở thư mục gốc và thay toàn bộ giá trị mẫu trước khi triển khai.

# Central server
CENTRAL_DATABASE_URL=postgresql+psycopg2://classroom:classroom@localhost:5432/classroom
CENTRAL_QDRANT_URL=http://localhost:6333
CENTRAL_QDRANT_COLLECTION=face_embeddings
CENTRAL_EDGE_TOKENS=edge-01:replace-with-edge-token
CENTRAL_JWT_SECRET=replace-with-a-long-random-secret
CENTRAL_ADMIN_EMAIL=admin@classroom.local
CENTRAL_ADMIN_PASSWORD=replace-with-a-strong-password

# Edge server
EDGE_EDGE_ID=edge-01
EDGE_NAME=Server biên nhà A
EDGE_CENTRAL_URL=http://127.0.0.1:9000
EDGE_CENTRAL_TOKEN=replace-with-edge-token
EDGE_ADMIN_PASSWORD=replace-with-a-strong-password
EDGE_JWT_SECRET=replace-with-a-long-random-secret
EDGE_SERVICE_TOKEN=replace-with-a-worker-token
# EDGE_PUBLIC_HOST=192.168.1.10
EDGE_MQTT_HOST=localhost
EDGE_MQTT_PORT=1883
EDGE_MQTT_USERNAME=backend
EDGE_MQTT_PASSWORD=replace-with-mqtt-password

# Frontend development proxy
BACKEND_URL=http://127.0.0.1:9000
